{
  "name": "crawlee-server",
  "version": "2.0.0",
  "description": "Self-hosted crawling API: Crawlee for fast bounded crawls, structured records with per-field provenance, SSRF-safe.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "src/server.mjs",
  "repository": { "type": "git", "url": "git+https://github.com/j-zulick/crawlee-server.git" },
  "homepage": "https://github.com/j-zulick/crawlee-server#readme",
  "keywords": ["crawlee", "web-crawler", "web-scraping", "structured-data", "schema-org", "self-hosted"],
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/*.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@crawlee/cheerio": "3.18.2",
    "@crawlee/core": "3.18.2",
    "cheerio": "1.2.0",
    "zod": "4.6.7"
  }
}
